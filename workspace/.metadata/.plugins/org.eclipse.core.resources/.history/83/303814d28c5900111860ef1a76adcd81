double double_in(char *prompt)
{
	//printf_lcd("%s",prompt);

	//initialize error_code
	int error_code = -1;

	//Reads from keypad and immediately echos what is typed.
	char buffer[40];

	while(error_code != 0)
	{
		printf_lcd("\f%s\n",prompt);
		if(error_code!=0)
			printf_lcd("Error Code: %d\n",error_code);

		fgets_keypad(buffer, 40);

		/*Error Checking stage
		Error Codes
		1 - Nothing entered
		2 - UP or DOWN entered
		3 - Minus sign (-) not the first character
		4 - Multiple decimal points
		*/

		error_code = check_error(buffer);

	}

	return 200;
}

int check_error(char *input_buffer)
{

	//check for nothing entered
	if(input_buffer[0]=='\0')
		return 1;
	else return 0;

}
