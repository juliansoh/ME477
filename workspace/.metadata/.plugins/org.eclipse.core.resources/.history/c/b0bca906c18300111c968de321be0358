void* Timer_ISR(void *resource)
{
	int iseg = -1;
	int itime = -1;
	int nsamp = 0;

	double Pref_rev = 0.0;
	double Pact_counts = 0.0;
	double Pact_rev = 0.0;

	double Pref_rad = 0.0;
	double Pact_rad = 0.0;

	double error = 0.0;
	double ua = 0.0;

	ThreadResource *threadResource = (ThreadResource*) resource;

    uint32_t irqAssert = 0;

    double *pref  = &((threadResource->a_table + 0)->value);
    double *pact  = &((threadResource->a_table + 1)->value);
    double *VDAmV = &((threadResource->a_table + 2)->value);

    seg *mySegs = threadResource->profile;
    int nseg = threadResource->nseg;
    /*
     * Initialize analog output.
     * Lab 7 says output to connector C, channel AOC0.
     */
    MyRio_Aio AOC0;
    Aio_InitCO0(&AOC0);
    Aio_Write(&AOC0, 0.0);

    // Initialize encoder
    EncoderC_initialize(myrio_session, &encC0);

    int i;
    for(i = 0; i < PIDF_ns; i++)
    {
        PIDF[i].x0 = 0.0;
        PIDF[i].x1 = 0.0;
        PIDF[i].x2 = 0.0;

        PIDF[i].y1 = 0.0;
        PIDF[i].y2 = 0.0;
    }

    while (threadResource->irqThreadRdy == NiFpga_True)
    {
        Irq_Wait(threadResource->irqContext,
                 TIMERIRQNO,
                 &irqAssert,
                 (NiFpga_Bool*) &(threadResource->irqThreadRdy));

        if (irqAssert & (1 << TIMERIRQNO))
        {
        	/*
        	 * Fixed 5 ms basic time interval.
        	 */
        	timeoutValue = 5000;

        	NiFpga_WriteU32(myrio_session,
        	                IRQTIMERWRITE,
        	                timeoutValue);

        	NiFpga_WriteBool(myrio_session,
        	                 IRQTIMERSETTIME,
        	                 NiFpga_True);

        	/*
        	 * Compute reference position from path profile.
        	 * Sramps returns Pref_rev in revolutions.
        	 */
        	nsamp = Sramps(mySegs,
        	               nseg,
        	               &iseg,
        	               &itime,
        	               T_SEC,
        	               &Pref_rev);

        	/*
        	 * Read actual motor position.
        	 * pos() returns encoder counts relative to the first reading.
        	 */
        	Pact_counts = pos();

        	/*
        	 * Convert actual position from counts to revolutions.
        	 */
        	Pact_rev = Pact_counts / CPR;

        	/*
        	 * Convert both positions to radians for the controller.
        	 */
        	Pref_rad = Pref_rev * 2.0 * M_PI;
        	Pact_rad = Pact_rev * 2.0 * M_PI;

        	/*
        	 * Position error.
        	 */
        	error = Pref_rad - Pact_rad;

        	/*
        	 * PIDF position control.
        	 */
        	ua = cascade(error,
        	             PIDF,
        	             PIDF_ns,
        	             -10.0,
        	              10.0);

        	/*
        	 * Send control output to DAC.
        	 */
        	Aio_Write(&AOC0, ua);

        	/*
        	 * Update table display.
        	 */
        	*pref = Pref_rev;
        	*pact = Pact_rev;
        	*VDAmV = ua * 1000.0;

        	/*
        	 * Save data.
        	 */
        	if(idx < NPTS)
        	{
        	    pref_rad_buf[idx] = Pref_rad;
        	    pact_rad_buf[idx] = Pact_rad;
        	    vout_buf[idx]= ua;
        	    idx++;
        	}


            Irq_Acknowledge(irqAssert);
        }
    }
    Aio_Write(&AOC0, 0.0);

    // Write data to MATLAB file
    MATFILE *mf;
    int err;
    double Tsave = T_SEC;

    mf = openmatfile("Lab8.mat", &err);

    if(!mf)
    {
        printf("Can't open mat file %d\n", err);
    }
    else
    {
        matfile_addstring(mf,
                          "myName",
                          "Julian Soh");

        matfile_addmatrix(mf,
                          "Pref",
                          pref_rad_buf,
                          idx,
                          1,
                          0);

        matfile_addmatrix(mf,
                          "Pact",
                          pact_rad_buf,
                          idx,
                          1,
                          0);

        matfile_addmatrix(mf,
                          "Vout",
                          vout_buf,
                          idx,
                          1,
                          0);

        matfile_addmatrix(mf,
                          "PIDF",
                          (double *)PIDF,
                          PIDF_ns * 11,
                          1,
                          0);

        matfile_addmatrix(mf,
                          "T",
                          &Tsave,
                          1,
                          1,
                          0);

        matfile_close(mf);
    }

    pthread_exit(NULL);
    return NULL;
}

double cascade(double xin, struct biquad *fa, int ns, double ymin, double ymax)
{
    struct biquad *f;
    double x0 = xin;
    double y0 = 0.0;
    int i;

    f = fa;   // point to first biquad section

    for (i = 0; i < ns; i++)
    {
        // Compute current output (difference equation)
        y0 = (f->b0 * x0 +
              f->b1 * f->x1 +
              f->b2 * f->x2 -
              f->a1 * f->y1 -
              f->a2 * f->y2) / f->a0;

        // Update stored history
        f->x2 = f->x1;
        f->x1 = x0;

        f->y2 = f->y1;
        f->y1 = y0;

        // Output becomes input to next section
        x0 = y0;

        // Move to next biquad
        f++;
    }

    // Apply saturation AFTER final section
    y0 = SATURATE(y0, ymin, ymax);

    return y0;
}

char getkey(void)
{
    static MyRio_Dio ch[8];
    static int firstrun;
    int i;
    int r = 0, c = 0;
    bool b;

    const char table[4][4] = {
        {'1','2','3', UP},
        {'4','5','6', DN},
        {'7','8','9', ENT},
        {'0','.','-', DEL}
    };

    if (firstrun != 1)
    {
        for(i=0; i<8; i++)
        {
            ch[i].dir = DIOB_70DIR;
            ch[i].out = DIOB_70OUT;
            ch[i].in  = DIOB_70IN;
            ch[i].bit = i;
        }

        firstrun = 1;
    }

    b = NiFpga_True;

    for (i = 0; i < 8; i++)
    {
        Dio_ReadBit(&ch[i]);
    }

    while (b == true)
    {
        for (c = 0; c < 4; c++)
        {
            for (i = 0; i < 4; i++)
            {
                Dio_ReadBit(&ch[i]);
            }

            Dio_WriteBit(&ch[c], NiFpga_False);

            for (r = 0; r < 4; r++)
            {
                b = Dio_ReadBit(&ch[r + 4]);

                if (b == false)
                {
                    break;
                }
            }

            if (b == false)
            {
                break;
            }

            wait();
        }
    }

    /* WAIT FOR KEY RELEASE */
    while (Dio_ReadBit(&ch[r + 4]) == false)
    {
        wait();
    }

    return table[r][c];
}

void wait(void)	//Wait function
{
	uint32_t i;
	i=417000;
	while(i>0)
	{
		i--;
	}
	return;
}

double pos(void)
{
    static int32_t first_count;
    static int firstcall = 0;

    int32_t curr_count;

    curr_count = Encoder_Counter(&encC0);

    if(firstcall != 1)
    {
        first_count = curr_count;
        firstcall = 1;
    }

    return (double)(curr_count - first_count);
}

