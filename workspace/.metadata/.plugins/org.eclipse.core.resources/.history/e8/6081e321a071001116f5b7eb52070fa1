/* definitions */
typedef struct {
	NiFpga_IrqContext irqContext;	//IRQ context reserved
	NiFpga_Bool irqThreadRdy;		//IRQ thread ready flag
	uint8_t irqNumber;				//IRQ number value
} ThreadResource;

struct biquad {
    double b0, b1, b2;
    double a0, a1, a2;
    double x0, x1, x2;
    double y1, y2;
};

#define NOKEY 127

/* Global variables */
int timeoutValue = 5;

int main(int argc, char **argv)
{
	NiFpga_Status status;
	int32_t irq_status;
	//uint8_t irqNumber = 2;
	MyRio_IrqTimer irqTimer0;
	pthread_t thread;

	// ----------------- IRQ Channel Registers ----------
	irqTimer0.timerWrite = IRQTIMERWRITE;
	irqTimer0.timerSet = IRQTIMERSETTIME;

	// -------------------- THREAD RESOURCE --------------

	ThreadResource irqThread0;

	// -------------------- OPEN MYRIO -------------------

	status = MyRio_Open();		    			// open FPGA session
    if (MyRio_IsNotSuccess(status)) return status;


    // ------------------- REGISTER INTERRUPT ------------

    //1. Register DIO IRQ. Terminate if not successful
	irq_status = Irq_RegisterTimerIrq(&irqTimer0,
							          &irqThread0.irqContext,
							          timeoutValue);

	if(irq_status != 0)
	{
		printf_lcd("/fTimer Interrupt registration failed\n");
		MyRio_Close();
		return -1;
	}

	// -------------------- ENABLE THREAD --------------------
	//Set the ready flag to enable the new thread
	irqThread0.irqThreadRdy = NiFpga_True;

	// ------------ CREATE ISR THREAD TO SERVICE IRQ ---------

	//2, Create new thread to catch the IRQ
	irq_status = pthread_create(&thread,
								NULL,			//attr default ok
								Timer_ISR,			//Start routine
								&irqThread0);

	// ---------------------- MAIN LOOP ----------------------
	printf_lcd("\f BACK key to quit");

	char key;

	while (1)
	{
		key = getkey();

    	if (key == DEL)
    	{
    		break;
    	}

	}

	// ----------------- STOP THREAD ---------------------
	irqThread0.irqThreadRdy = NiFpga_False;

	//Wait for ISR Thread to terminate
	pthread_join(thread,NULL);

	// --------------- UNREGISTER INTERRUPT --------------
	Irq_UnregisterTimerIrq(&irqTimer0,irqThread0.irqContext);


	// --------------- CLOSE MYRIO SESSION ---------------
    printf_lcd("\fBye...");		// Print to LCD display

	status = MyRio_Close();						// close FPGA session

	return status;
}

void* Timer_ISR(void *resource)
{
    ThreadResource *threadResource = (ThreadResource*) resource;

    uint32_t irqAssert = 0;

    //---------------------- Initialize AIO C0 & C1 and set C1 to 0 V ----------------
    MyRio_Aio C0;
    MyRio_Aio C1;

    C0->dir = AIOCDIR;
    C0->val = AIOC0;

    C1.dir = AIOCDIR;
    C1.val = AIOC1;

    Aio_Write(&C1, 0, 0);

    //--------------------------------------------------------------------------

    while (threadResource->irqThreadRdy == NiFpga_True)
    {
        Irq_Wait(threadResource->irqContext,
                 TIMERIRQNO,
                 &irqAssert,
                 (NiFpga_Bool*) &(threadResource->irqThreadRdy));   //  no return value

        //  ONLY act if interrupt actually triggered
        if (irqAssert & (1 << TIMERIRQNO))
        {

        	NiFpga_WriteU32(myrio_session,
                            IRQTIMERWRITE,
                            timeoutValue);

            NiFpga_WriteBool(myrio_session,
                             IRQTIMERSETTIME,
                             NiFpga_True);

            Irq_Acknowledge(irqAssert);
        }
    }

    pthread_exit(NULL);
    return NULL;
}

char getkey(void)
{
    static MyRio_Dio ch[8];
    static int initialized = 0;

    int i, row, col;
    int r = -1, c = -1;

    const char table[4][4] = {
        {'1','2','3', UP},
        {'4','5','6', DN},
        {'7','8','9', ENT},
        {'0','.','-', DEL}
    };

    // Init once
    if (!initialized)
    {
        for (i = 0; i < 8; i++)
        {
            ch[i].dir = DIOB_70DIR;
            ch[i].out = DIOB_70OUT;
            ch[i].in  = DIOB_70IN;
            ch[i].bit = i;
        }
        initialized = 1;
    }

    // Set all lines to input
    for (i = 0; i < 8; i++)
    {
        Dio_ReadBit(&ch[i]);
    }

    // Scan columns
    for (col = 0; col < 4; col++)
    {
        // reset columns
        for (i = 0; i < 4; i++)
        {
            Dio_ReadBit(&ch[i]);
        }

        // drive column LOW
        Dio_WriteBit(&ch[col], NiFpga_False);

        // scan rows
        for (row = 0; row < 4; row++)
        {
            if (Dio_ReadBit(&ch[row + 4]) == false)
            {
                r = row;
                c = col;

                wait();   // debounce
                return table[r][c];   // SAFE return immediately
            }
        }
    }

    return 0;   // no key
}

