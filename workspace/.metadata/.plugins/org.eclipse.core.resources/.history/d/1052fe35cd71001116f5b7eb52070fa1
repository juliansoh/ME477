void* Timer_ISR(void *resource)
{
    ThreadResource *threadResource = (ThreadResource*) resource;

    uint32_t irqAssert = 0;

    //---------------------- Initialize AIO C0 & C1 and set C1 to 0 V ----------------
    // See page 300 of textbook

    MyRio_Aio AIC0;		// Connector C analog input 0
    MyRio_Aio AOC1;		// Connector C analog output 1
    Aio_InitCI0(&AIC0);	// Initialize input 0
    Aio_InitCO1(&AOC1);	// Initialize output 1

    Aio_Write(&AOC1, 0.0);	// Set analog output 1 to 0.0V

    //--------------------------------------------------------------------------------

    while (threadResource->irqThreadRdy == NiFpga_True)
    {
    	Irq_Wait(threadResource->irqContext,
                 TIMERIRQNO,
                 &irqAssert,
                 (NiFpga_Bool*) &(threadResource->irqThreadRdy));   //  no return value

        //  ONLY act if interrupt actually triggered

    	//Debug for thread interrupt (Isolating segmentation Fault)
    	//while (threadResource->irqThreadRdy == NiFpga_True)
    	//{
    	//    printf("Thread alive\n");
    	//    wait();
    	//}
    	//

        if (irqAssert & (1 << TIMERIRQNO))
        {

        	NiFpga_WriteU32(myrio_session,
                            IRQTIMERWRITE,
                            timeoutValue);

            NiFpga_WriteBool(myrio_session,
                             IRQTIMERSETTIME,
                             NiFpga_True);

            // read input (See page 301 of textbook)
            double xin = Aio_Read(&AIC0);

            // L6.1 pass-through and write input directly to output (for now)
            //double yout = xin;
            //L6.2 Use cascade()
            double yout;
            yout = cascade(xin, myFilter, myFilter_ns, -10.0, 10.0);

            //write output (See page 301 of textbook)
            Aio_Write(&AOC1, yout);

            //For Problem L6.3 - Save output to buffers
            if (idx < N)	//Collect 500 samples
            {
                t_buf[idx] = idx * (timeoutValue / 1000.0);  // approximate time
                x_buf[idx] = xin;
                y_buf[idx] = yout;
                idx++;
            }
            if (idx >= N)	//Stop collecting after 500 samples
            {
                threadResource->irqThreadRdy = NiFpga_False;
            }

            Irq_Acknowledge(irqAssert);
        }
    }

    pthread_exit(NULL);
    return NULL;
}

double cascade(double xin, struct biquad *fa, int ns, double ymin, double ymax)
{
    struct biquad *f;
    double x0 = xin;
    double y0 = 0.0;
    int i;

    f = fa;   // point to first biquad section

    for (i = 0; i < ns; i++)
    {
        // Compute current output (difference equation)
        y0 = (f->b0 * x0 +
              f->b1 * f->x1 +
              f->b2 * f->x2 -
              f->a1 * f->y1 -
              f->a2 * f->y2) / f->a0;

        // Update stored history
        f->x2 = f->x1;
        f->x1 = x0;

        f->y2 = f->y1;
        f->y1 = y0;

        // Output becomes input to next section
        x0 = y0;

        // Move to next biquad
        f++;
    }

    // Apply saturation AFTER final section
    y0 = SATURATE(y0, ymin, ymax);

    return y0;
}

char getkey(void)
{
    static MyRio_Dio ch[8];
    static int initialized = 0;

    int i, row, col;
    int r = -1, c = -1;

    const char table[4][4] = {
        {'1','2','3', UP},
        {'4','5','6', DN},
        {'7','8','9', ENT},
        {'0','.','-', DEL}
    };

    // Init once
    if (!initialized)
    {
        for (i = 0; i < 8; i++)
        {
            ch[i].dir = DIOB_70DIR;
            ch[i].out = DIOB_70OUT;
            ch[i].in  = DIOB_70IN;
            ch[i].bit = i;
        }
        initialized = 1;
    }

    // Set all lines to input
    for (i = 0; i < 8; i++)
    {
        Dio_ReadBit(&ch[i]);
    }

    // Scan columns
    for (col = 0; col < 4; col++)
    {
        // reset columns
        for (i = 0; i < 4; i++)
        {
            Dio_ReadBit(&ch[i]);
        }

        // drive column LOW
        Dio_WriteBit(&ch[col], NiFpga_False);

        // scan rows
        for (row = 0; row < 4; row++)
        {
            if (Dio_ReadBit(&ch[row + 4]) == false)
            {
                r = row;
                c = col;

                wait();   // debounce
                return table[r][c];   // SAFE return immediately
            }
        }
    }

    return 0;   // no key
}

