/* prototypes */
void wait(void);
void* DI_ISR(void *thread_reource);

/* definitions */
typedef struct {
	NiFpga_IrqContext irqContext;	//IRQ context reserved
	NiFpga_Bool irqThreadRdy;		//IRQ thread ready flag
	uint8_t irqNumber;				//IRQ number value
} ThreadResource;

int main(int argc, char **argv)
{
	NiFpga_Status status;
	int32_t irq_status;
	uint8_t irqNumber = 2;

	// -------------------- IRQ CONFIG ------------------

	//Specify IRQ channel settings
	MyRio_IrqDi irqDIO;
	irqDIO.dioCount			= IRQDIO_A_0CNT;
	irqDIO.dioIrqNumber		= IRQDIO_A_0NO;
	irqDIO.dioIrqEnable		= IRQDIO_A_70ENA;
	irqDIO.dioIrqRisingEdge	= IRQDIO_A_70RISE;
	irqDIO.dioIrqFallingEdge= IRQDIO_A_70FALL;
	irqDIO.dioChannel		= Irq_Dio_A1;

	// -------------------- THREAD RESOURCE --------------

	//Declare the thread resource and set the IRQ number
	ThreadResource irqThread0;
	irqThread0.irqNumber = irqNumber;


	// -------------------- OPEN MYRIO -------------------

	status = MyRio_Open();		    			// open FPGA session
    if (MyRio_IsNotSuccess(status)) return status;


    // ------------------- REGISTER INTERRUPT ------------

    //1. Register DIO IRQ. Terminate if not successful
	irq_status = Irq_RegisterDiIrq(&irqDIO,
							       &(irqThread0.irqContext),
							       irqNumber,				//IrqNumber
							       1,						//Count
							       Irq_Dio_FallingEdge);	//TriggerType

	if(irq_status != 0)
	{
		printf_lcd("/fIRQ registration failed\n");
		MyRio_Close();
		return -1;
	}

	// -------------------- ENABLE THREAD --------------------
	//Set the ready flag to enable the new thread
	irqThread0.irqThreadRdy = NiFpga_True;

	// ------------ CREATE ISR THREAD TO SERVICE IRQ ---------

	//2, Create new thread to catch the IRQ
	pthread_t thread;
	irq_status = pthread_create(&thread,
								NULL,			//attr default ok
								DI_ISR,			//Start routine
								&irqThread0);

	// ---------------------- MAIN LOOP ----------------------

	int count = 0;

	while(count<60)
	{
		// Wait 1 sec by calling wait() 200 times since 1 x wait() approx. 5ms
		int i;
		for(i=0; i<200;i++)
		{
			wait();
		}

		//Clear and print count
		printf_lcd("\fCount: %d",count);

		count++;
	}

	// ----------------- STOP THREAD ---------------------
	irqThread0.irqThreadRdy = NiFpga_False;

	//Wait for ISR Thread to terminate
	pthread_join(thread,NULL);

	// --------------- UNREGISTER INTERRUPT --------------
	//Irq_UnregisterDiIrq(&irqDIO,&(irqThread0.irqContext),irqThread0.irqNumber,1);


	// --------------- CLOSE MYRIO SESSION ---------------
    printf_lcd("\fBye...");		// Print to LCD display

	status = MyRio_Close();						// close FPGA session

	return status;
}

void* DI_ISR(void *resource)
{
	// Service the interrupt

	//cast input resource
	ThreadResource *threadResource = (ThreadResource*) resource;

	uint32_t irqAssert = 0;

	while(threadResource->irqThreadRdy == NiFpga_True)
	{
		// -------------- Loop Task 1: Wait for IRQ or timeout ----------
		Irq_Wait(threadResource->irqContext,
				 threadResource->irqNumber,
				 &irqAssert,
				 (NiFpga_Bool*) &(threadResource->irqThreadRdy));

		// --------------- Loop Task 2: Check if IRQ occurred -----------
		if(irqAssert & (1 << threadResource->irqNumber))
		{
			//Service the interrupt
			printf_lcd("interrupt_");

			//Acknowledge interrupt
			Irq_Acknowledge(irqAssert);
		}
	}

	// --------------- ISR Task 3: Exit thread
	pthread_exit(NULL);
	return NULL;
}

void wait(void)	//Wait function
{
	uint32_t i;
	i=417000;
	while(i>0)
	{
		i--;
	}
	return;
}

