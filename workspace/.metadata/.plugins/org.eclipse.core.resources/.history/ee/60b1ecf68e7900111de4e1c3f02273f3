	while(i>0)
	{
		i--;
	}
	return;
}

double vel(void)
{
	static int32_t prev_count;
	static int firstcall=0;
    int32_t curr_count;
    int32_t diff;

    // Step 1: Read current encoder count
    curr_count = Encoder_Counter(&encC0);

    // Handle first call
	if(firstcall != 1)
	{
	    prev_count = curr_count;
	    firstcall = 1;
	    return 0.0;
	}

	// Step 2: Compute speed difference between current and previous counts
	diff = curr_count - prev_count;

	// Step 3: Update Previous Count
	prev_count = curr_count;

	//Step 4: Convert to speed (RPM)
	// 2048 per revolution
	// 1 BTI per call

    //double rpm = (double)diff * (60.0 / 2048.0);

    return (double)diff;
}

