void* Timer_ISR(void *resource)
{
    ThreadResource *threadResource = (ThreadResource*) resource;

    uint32_t irqAssert = 0;

    /*
     * Convenient names for table entries.
     * These are pointers to the values inside my_table.
     */
    double *Omega_R = &((threadResource->a_table + 0)->value);   // V_R: rpm, edit
    double *Omega_J = &((threadResource->a_table + 1)->value);   // V_J: rpm, show
    double *VDAout  = &((threadResource->a_table + 2)->value);   // VDAout: mV, show
    double *Kp      = &((threadResource->a_table + 3)->value);   // Kp: V-s/r, edit
    double *Ki      = &((threadResource->a_table + 4)->value);   // Ki: V/r, edit
    double *BTI     = &((threadResource->a_table + 5)->value);   // BTI: ms, edit

    /*
     * Initialize analog output.
     * Lab 7 says output to connector C, channel AOC0.
     */
    MyRio_Aio AOC0;
    Aio_InitCO0(&AOC0);
    Aio_Write(&AOC0, 0.0);

    // Initialize encoder
    EncoderC_initialize(myrio_session, &encC0);

    myFilter[0].x0 = 0.0;
    myFilter[0].x1 = 0.0;
    myFilter[0].x2 = 0.0;

    myFilter[0].y1 = 0.0;
    myFilter[0].y2 = 0.0;

    static double prevKp = 0.0;
    static double prevKi = 0.0;
    static double prevBTI = 0.0;

    while (threadResource->irqThreadRdy == NiFpga_True)
    {
        Irq_Wait(threadResource->irqContext,
                 TIMERIRQNO,
                 &irqAssert,
                 (NiFpga_Bool*) &(threadResource->irqThreadRdy));

        if (irqAssert & (1 << TIMERIRQNO))
        {
            /*
             * Set timer for next BTI.
             * BTI is in ms from the table.
             * Timer register uses microseconds, so multiply by 1000.
             */
            timeoutValue = (uint32_t)(*BTI * 1000.0);
        	//timeoutValue = 5000;

            NiFpga_WriteU32(myrio_session,
                            IRQTIMERWRITE,
                            timeoutValue);

            NiFpga_WriteBool(myrio_session,
                             IRQTIMERSETTIME,
                             NiFpga_True);

            /*
             * Measure motor velocity.
             *
             * Use your Lab 4 vel() function here.
             * It should return angular velocity.
             *
             * For now I am writing this as:
             */
            double omega_j = vel();

            /*
             * Convert BTI from ms to seconds for equation 7.43.
             */
            double T = (*BTI) / 1000.0;

            /*
             * Update PI controller coefficients from equation 7.43:
             *
             * a0 = 1
             * a1 = -1
             * b0 = Kp + 0.5 Ki T
             * b1 = -Kp + 0.5 Ki T
             */
            myFilter[0].a0 = 1.0;
            myFilter[0].a1 = -1.0;
            myFilter[0].a2 = 0.0;

            myFilter[0].b0 = (*Kp) + 0.5 * (*Ki) * T;
            myFilter[0].b1 = -(*Kp) + 0.5 * (*Ki) * T;
            myFilter[0].b2 = 0.0;

            /* Reset controller state ONLY if gains or BTI changed */
            if ((*Kp != prevKp) ||
            	(*Ki != prevKi) ||
            	(*BTI != prevBTI))
            {
            	myFilter[0].x1 = 0.0;
            	myFilter[0].x2 = 0.0;
            	myFilter[0].y1 = 0.0;
            	myFilter[0].y2 = 0.0;

            	prevKp  = *Kp;
            	prevKi  = *Ki;
            	prevBTI = *BTI;
            }

            //Capture values with the step process (to be saved to file)
            if (*Omega_R != prevOmegaR_save)
            {
                idx = 0;
                prevOmegaR_save = currentOmegaR;
                currentOmegaR = *Omega_R;

                saveKp = *Kp;
                saveKi = *Ki;
                saveBTI = *BTI;

                prevOmegaR_save = *Omega_R;
            }
            /*
             * Error = reference velocity - measured velocity.
             */
            double error = (*Omega_R) - omega_j;

            //Diagnostics
            //*Omega_J = omega_j;
            //*VDAout = error;

            /*
             * Use cascade() to compute PI control output.
             * Limit output to [-10, +10] V.
             */

            //Diagnostics - Reset (Forgets previous values)
            //myFilter[0].x1 = 0.0;
            //myFilter[0].x2 = 0.0;
            //myFilter[0].y1 = 0.0;
            //myFilter[0].y2 = 0.0;
            //////

            double ua = cascade(error,
                                myFilter,
                                myFilter_ns,
                                -10.0,
                                10.0);

            if (idx < NPTS)
            {
                omegaJ_buf[idx] = omega_j;
                ua_buf[idx] = ua;
                idx++;
            }


            //Send control output to DAC AOC0.

            Aio_Write(&AOC0, ua);

             // Update show values in the table.

             // Omega_J table display is rpm.
             // VDAout table display is mV.
             //
            *Omega_J = omega_j;
            *VDAout = ua * 1000.0;

            /*
             * Save results later.
             * We are intentionally leaving this blank for now.
             */

            Irq_Acknowledge(irqAssert);
        }
    }

    // Write data to file
    FILE *fp;

    fp = fopen("Lab7.csv", "w");

    /* Metadata */

    fprintf(fp, "Name,Julian Soh\n");
    fprintf(fp, "CurrentOmegaR,%f\n", currentOmegaR);
    fprintf(fp, "PreviousOm*gaR,%f\n", previousOmegaR);
    fprintf(fp, "Kp,%f\n", saveKp);
    fprintf(fp, "Ki,%f\n", saveKi);
    fprintf(fp, "BTI,%f\n", saveBTI);
    fprintf(fp, "\n");

    /* Data */

    fprintf(fp, "Sample,Omega_J,Ua\n");

    for(int i = 0; i < idx; i++)
    {
        fprintf(fp,
        		"%d,%f,%f\n",
        		i,
                omegaJ_buf[i],
                ua_buf[i]);
    }

    fclose(fp);

    /*
     * Stop motor output before thread exits.
     */
    Aio_Write(&AOC0, 0.0);
    //Aio_Write(&AOC1, 0.0);

    pthread_exit(NULL);
    return NULL;
}

double cascade(double xin, struct biquad *fa, int ns, double ymin, double ymax)
{
    struct biquad *f;
    double x0 = xin;
    double y0 = 0.0;
    int i;

    f = fa;   // point to first biquad section

    for (i = 0; i < ns; i++)
    {
        // Compute current output (difference equation)
        y0 = (f->b0 * x0 +
              f->b1 * f->x1 +
              f->b2 * f->x2 -
              f->a1 * f->y1 -
              f->a2 * f->y2) / f->a0;

        // Update stored history
        f->x2 = f->x1;
        f->x1 = x0;

        f->y2 = f->y1;
        f->y1 = y0;

        // Output becomes input to next section
        x0 = y0;

        // Move to next biquad
        f++;
    }

    // Apply saturation AFTER final section
    y0 = SATURATE(y0, ymin, ymax);

    return y0;
}

char getkey(void)
{
    static MyRio_Dio ch[8];
    static int firstrun;
    int i;
    int r = 0, c = 0;
    bool b;

    const char table[4][4] = {
        {'1','2','3', UP},
        {'4','5','6', DN},
        {'7','8','9', ENT},
        {'0','.','-', DEL}
    };

    if (firstrun != 1)
    {
        for(i=0; i<8; i++)
        {
            ch[i].dir = DIOB_70DIR;
            ch[i].out = DIOB_70OUT;
            ch[i].in  = DIOB_70IN;
            ch[i].bit = i;
        }

        firstrun = 1;
    }

    b = NiFpga_True;

    for (i = 0; i < 8; i++)
    {
        Dio_ReadBit(&ch[i]);
    }

    while (b == true)
    {
        for (c = 0; c < 4; c++)
        {
            for (i = 0; i < 4; i++)
            {
                Dio_ReadBit(&ch[i]);
            }

            Dio_WriteBit(&ch[c], NiFpga_False);

            for (r = 0; r < 4; r++)
            {
                b = Dio_ReadBit(&ch[r + 4]);

                if (b == false)
                {
                    break;
                }
            }

            if (b == false)
            {
                break;
            }

            wait();
        }
    }

    /* WAIT FOR KEY RELEASE */
    while (Dio_ReadBit(&ch[r + 4]) == false)
    {
        wait();
    }

    return table[r][c];
}

